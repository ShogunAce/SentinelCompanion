# Copy to .env for local runs only. Never commit .env.

# Browser origins allowed to call the API (comma separated). Use your deployed Sentinel front end.
ALLOWED_ORIGINS=https://your-sentinel-frontend.example

# Shown in the scanner's User-Agent so site owners can reach you. REQUIRED for a public deploy.
SCANNER_CONTACT=you@your-domain.example

# How many proxies sit in front of this service (Cloud Run = 1). Verify with GET /api/whoami.
TRUST_PROXY_HOPS=1

# Optional tuning (defaults shown)
# MAX_REQUESTS_PER_SCAN=10
# MAX_SCRIPTS=5
# REQUEST_SPACING_MS=400
# SCANS_PER_HOUR_PER_CLIENT=6
# SCANS_PER_HOUR_GLOBAL=150
# MAX_CONCURRENT_SCANS=3
# HOST_COOLDOWN_SECONDS=600
